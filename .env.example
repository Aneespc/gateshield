# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="PASTE_NEON_POOLED_CONNECTION_STRING_HERE"
# Neon direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL="PASTE_NEON_DIRECT_CONNECTION_STRING_HERE"
# Random string, at least 32 chars, for signing session cookies
SESSION_SECRET="PASTE_RANDOM_32_PLUS_CHAR_SECRET_HERE"
# Shared secret the gateway sends to upstream apps so they can reject direct traffic
GATEWAY_SHARED_SECRET="PASTE_ANOTHER_RANDOM_SECRET_HERE"

# Optional: Base URL for upstream dummy services (defaults to http://localhost:5173 locally, production Vercel URL when deployed)
DUMMY_UPSTREAM_BASE_URL="http://localhost:5173"
# Optional: Simulated country code for local development testing (ISO 2-letter, e.g. "US")
DEV_COUNTRY="US"

# Optional: Enable demo mode for simulated country/time and demo console controls ("true" or "false", default "true")
# Must be set to "false" in any real deployment because simulated values come from user session.
DEMO_MODE="true"
# Optional: Fixed code accepted on the re-authentication page (default "123456")
DEMO_STEP_UP_CODE="123456"
